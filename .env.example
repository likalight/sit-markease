# Real Supabase project (unused while AIMS_FIXTURE_MODE=true — see docs/DECISIONS.md).
# Intended production path once a project + paid no-training endpoint are provisioned.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SIDECAR_URL=http://localhost:8000

# --- LLM providers (free-tier; docs/DECISIONS.md "M2 — free-tier providers") ---
# Provider per model role. "gemini" | "groq". Swapping to a paid provider later
# is a new src/lib/ai/providers/*.ts file + changing these three lines.
AIMS_PROVIDER_PRIMARY=gemini
AIMS_PROVIDER_FAST=groq
AIMS_PROVIDER_ADJUDICATOR=gemini

AIMS_GEMINI_API_KEY=
AIMS_GEMINI_MODEL=gemini-2.0-flash
AIMS_GEMINI_RPM=10

AIMS_GROQ_API_KEY=
AIMS_GROQ_MODEL=llama-3.2-11b-vision-preview
AIMS_GROQ_RPM=25

AIMS_DUAL_READ_ENABLED=true
AIMS_AGREEMENT_THRESHOLD=0.85
AIMS_LINE_DETECTOR=opencv
AIMS_RETRIEVAL_MODE=hybrid

# true = every model call replays from local-data/ai-cache/ only, zero network
# calls, zero quota spend. Demo-day safety net — keep this working.
AIMS_FIXTURE_MODE=true

# Demo accounts. In fixture mode these are seeded straight into local-data/store.json
# (no password / no Supabase Auth); outside fixture mode they're real Supabase
# Auth accounts created by `npm run seed`.
AIMS_DEMO_EDUCATOR_EMAIL=educator@aims.demo
AIMS_DEMO_EDUCATOR_PASSWORD=aims-demo-educator-1
AIMS_DEMO_STUDENT_EMAIL=student@aims.demo
AIMS_DEMO_STUDENT_PASSWORD=aims-demo-student-1
